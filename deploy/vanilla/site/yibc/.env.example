# YIBC site env — loaded by /etc/default/companion at service start.
#
# DO NOT commit a copy with real credentials. Copy this file to
# /etc/default/companion on the Pi and edit there.
#
# Companion does not natively read these env vars at button-fire time
# — they are picked up at startup and exposed to the connection
# config dialogs. Operators paste them into Companion's web UI when
# adding/editing a connection.

# ─── Network identity ───────────────────────────────────────────────
COMPANION_SITE=yibc
COMPANION_LOCATION_LABEL="YIBC"

# ─── ProPresenter ──────────────────────────────────────────────────
PROPRESENTER_HOST=192.168.1.2
PROPRESENTER_PORT=1025
PROPRESENTER_PASSWORD=YIBC

# ─── Yamaha mixer ──────────────────────────────────────────────────
YAMAHA_HOST=192.168.1.54
YAMAHA_MODEL=TF

# ─── PTZ camera ────────────────────────────────────────────────────
PTZ_HOST=192.168.1.113
PTZ_PORT=5678

# ─── OBS Studio ────────────────────────────────────────────────────
OBS_HOST=192.168.1.50
OBS_PORT=4455
OBS_PASSWORD=

# ─── Spotify (Premium account required for playback) ─────────────────
# Get these from https://developer.spotify.com/dashboard
# Operator must complete OAuth in Companion web UI on first connect.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_PLAYLIST_URI=

# ─── ProPresenter macros (extracted from PP after install) ──────────
PRO7_CLOSING_GRAPHIC_MACRO_UUID=

# ─── Stream Deck IPs (populate after surface registration) ──────────
STREAMDECK_PLUS_IP=192.168.1.42
STREAMDECK_MK2_IP=192.168.1.43

# ─── Mixer record bus (confirm with operator) ───────────────────────
RECORD_BUS_IDX=21
