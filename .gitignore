# Logs
*.log
.bootstrap.log

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db

# Editor directories and files
.idea/
.vscode/*
!.vscode/tasks.json
!.vscode/settings.json
*.swp
*.swo
*~

# Secrets - NEVER commit unencrypted secrets
secrets/*.yaml
!secrets/*.template.yaml
!secrets/README.md
age.key

# Bootstrap configuration (contains API tokens, passwords)
.env.bootstrap
rancher/.rancher-info

# Age private keys
*.txt
key.txt

# Kubeconfig files
kubeconfig*
*.kubeconfig

# Terraform (if added later)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars

# Ansible
*.retry

# Temp files
tmp/
temp/
.tmp/

# Python (for ansible)
__pycache__/
*.py[cod]
.Python
venv/
ENV/

# Node (if any tooling)
node_modules/

# KIND cluster data
/tmp/kube-world/
pi-setup/cloud-init/output/
terraform.tfvars

# Companion generated artifacts (built by companion-deploy.py generate)
apps/companion/config/companion.companionconfig
apps/companion/config/companion.json
apps/companion/config/companion-export.json

# Cleartext secrets — never commit. Only the .sealed.yaml output of
# kubeseal goes into git.
apps/companion/secrets/*.unsealed.yaml
!apps/companion/secrets/*.unsealed.example.yaml

# Vanilla site env files — only commit .env.example, never .env
deploy/vanilla/site/*/.env
