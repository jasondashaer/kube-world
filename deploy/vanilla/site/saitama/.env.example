# Saitama site env — loaded by /etc/default/companion at service start.
#
# DO NOT commit a copy with real credentials. Copy this file to
# /etc/default/companion on the Pi and edit there.

# ─── Network identity ───────────────────────────────────────────────
COMPANION_SITE=saitama
COMPANION_LOCATION_LABEL="Saitama"

# ─── ProPresenter ──────────────────────────────────────────────────
PROPRESENTER_HOST=192.168.68.55
PROPRESENTER_PORT=53678
PROPRESENTER_PASSWORD=test1234

# ─── Yamaha mixer (TF1) ────────────────────────────────────────────
YAMAHA_HOST=192.168.10.30
YAMAHA_MODEL=TF

# ─── OBS Studio ────────────────────────────────────────────────────
OBS_HOST=192.168.10.50
OBS_PORT=4455
OBS_PASSWORD=

# ─── ATEM switcher ─────────────────────────────────────────────────
ATEM_HOST=192.168.10.40

# ─── Spotify (Premium) ─────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_PLAYLIST_URI=

# ─── ProPresenter macros ───────────────────────────────────────────
PRO7_CLOSING_GRAPHIC_MACRO_UUID=

# ─── Stream Deck IPs ───────────────────────────────────────────────
STREAMDECK_XL_IP=192.168.1.41

# ─── Mixer record bus ──────────────────────────────────────────────
RECORD_BUS_IDX=21
