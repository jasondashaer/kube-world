# kube-world Bootstrap Environment Variables
#
# Copy to .env.bootstrap and fill in values:
#   cp .env.example .env.bootstrap
#   $EDITOR .env.bootstrap
#   source .env.bootstrap && ./bootstrap.sh --platform pi --stack karmada
#
# Or use the setup wizard:
#   ./scripts/setup.sh
#
# Required for Pi + Karmada stack:

# Cloudflare API token (DNS-01 challenges for Let's Encrypt wildcard cert)
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Permissions: Zone:DNS:Edit for your domain
CLOUDFLARE_API_TOKEN=

# Tailscale API token (key management and auth key creation)
# Create at: https://login.tailscale.com/admin/settings/keys
# Type: API key, Scopes: all, Expiry: 90 days
TAILSCALE_API_TOKEN=

# Tailscale auth key for provisioning new nodes (auto-created if API token set)
# Leave blank to have bootstrap create one, or provide an existing key
TAILSCALE_AUTH_KEY=

# Central node's Tailscale IP (for edge DNS entries pointing to Rancher/GitLab)
# Find with: tailscale ip -4  (on the central node)
CENTRAL_TAILSCALE_IP=

# Optional overrides (defaults are usually fine):

# RANCHER_BOOTSTRAP_PASSWORD=     # Auto-generated if not set
# RANCHER_HOSTNAME=rancher.kubew.dev
# RANCHER_TLS_SOURCE=secret       # Auto-set for Pi karmada stack
# K3S_VERSION=v1.29.0+k3s1
# RANCHER_VERSION=2.13.1
